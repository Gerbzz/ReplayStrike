{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReplayStrike",
  "version": "0.3.0",
  "identifier": "gg.replaystrike.desktop",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ReplayStrike",
        "width": 1400,
        "height": 880,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; media-src asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "resources": { "whisper/*": "whisper/" },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}

