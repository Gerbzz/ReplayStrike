{
  "name": "replaystrike",
  "productName": "ReplayStrike",
  "version": "0.2.0",
  "description": "Find your game clips, make them look great, and share them in seconds.",
  "main": "src/main.js",
  "author": "Gerbzz",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "build": {
    "appId": "gg.replaystrike.app",
    "productName": "ReplayStrike",
    "files": [
      "src/**",
      "renderer/**",
      "build/icon.png",
      "package.json",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
